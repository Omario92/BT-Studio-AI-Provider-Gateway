# Server
PORT=8080
NODE_ENV=development

# Database & Cache
DATABASE_URL="postgresql://gateway:gateway123@localhost:5435/ai_gateway?schema=public"
REDIS_URL="redis://localhost:6379"

# Security
AI_GATEWAY_API_KEY="studio-gateway-secret-key-2026"
AI_GATEWAY_CALLBACK_SECRET="callback-hmac-sha256-signing-secret"

# ComfyUI Provider Config
COMFYUI_BASE_URL="https://comfyui.luonghuynh.org"
COMFYUI_AUTH_HEADER=""
COMFYUI_AUTH_HEADER_2=""
COMFYUI_TIMEOUT_MS=600000

# RunPod Provider Config
RUNPOD_API_KEY=""
RUNPOD_BASE_URL="https://api.runpod.ai/v2"
RUNPOD_ENDPOINT_ID=""

# OpenAI Config
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"

# Gemini Config
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="imagen-4.0-generate-preview-06-06"

# Workflows Config
WORKFLOW_STORAGE_MODE=database

# Diagnostics
DISABLE_MOCK_PROVIDER=false
LOG_LEVEL=info
